# Optional environment variables. Copy to .env and fill in — never commit .env.
# The core system works with NONE of these set.

# Reserved for a future verified broker-DEMO adapter (not implemented).
# The application refuses live endpoints regardless of these values.
FXAGENT_DEMO_BROKER=
FXAGENT_DEMO_ACCOUNT_ID=
FXAGENT_DEMO_API_TOKEN=

# Optional LLM explanation layer (never controls risk or orders).
FXAGENT_LLM_ENDPOINT=

# Override database path if needed.
FXAGENT_DB_PATH=
